#!/usr/bin/env bash

default_sink=$(pactl get-default-sink)
volume_info=$(pactl get-sink-volume "$default_sink" | grep -oP '\d+%' | head -1)
is_muted=$(pactl get-sink-mute "$default_sink" | grep -oP '(?<=Mute: )\w+')

if [ "$is_muted" = "yes" ]; then
    echo "🔇 MUTED"
else
    echo "🔊 $volume_info"
fi

